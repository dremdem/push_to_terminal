{
    // Where the local Ollama server listens.
    "url": "http://localhost:11434",

    // Model used for translation.  gemma3:4b was chosen by benchmark: it keeps
    // technical terminology intact where opus-mt mangles it, fits in 8 GB of
    // VRAM, and answers a sentence in ~400 ms.  Pull it with:
    //     ollama pull gemma3:4b
    "model": "gemma3:4b",

    // Seconds to wait for an answer.  A cold model load costs ~3 s.
    "timeout": 20.0,

    // How long Ollama keeps the model in VRAM after the last request.
    // gemma3:4b is ~3.8 GB resident, on a card that also draws your desktop —
    // so it is held through a reading session and released soon after, rather
    // than parked for half an hour.
    "keep_alive": "5m",

    // Load the model when Sublime starts, before you translate anything.
    // Off by default: it saves ~3 s on the first lookup and costs ~3.8 GB of
    // VRAM for the whole time the editor is open.  Turn it on only if your
    // GPU has room to spare.
    "warm_up_on_start": false,

    // What the text is about, applied to every translation.  Free text.
    //
    // Naming the genre alone helps only a little — it recovers dropped pronouns.
    // What actually fixes jargon is spelling out the ambiguous words, e.g.:
    //   "военный радиообмен; 'a hit' — засечка сигнала, не попадание снаряда;
    //    'read' — показание; 'popped' — телефон засветился в сети"
    //
    // Leave empty for a plain translation, and use
    // "Lingua: Translate with a hint…" to pick one per selection instead.
    "hint": "",

    // Presets offered by "Lingua: Translate with a hint…".
    "hints": [
        "техническая документация по программированию",
        "художественная проза, современный диалог",
        "военный/полицейский радиообмен; 'a hit' — засечка сигнала, не попадание снаряда; 'read' — показание/засечка",
        "юридический документ",
        "медицинский текст"
    ],

    // Translations are deterministic, so they are cached forever.
    // Delete this file to clear the cache.
    "cache_path": "~/.cache/sublime-lingua/cache.sqlite3"
}
